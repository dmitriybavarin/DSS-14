cmd-removeextracomponents-desc = Удаляет все компоненты, отсутствующие в прототипе, у всех сущностей с указанным идентификатором.\nЕсли идентификатор не указан, команда применяется ко всем сущностям.
cmd-removeextracomponents-help = removeextracomponents / removeextracomponents <entityId>
cmd-removeextracomponents-invalid-prototype-id = Не удалось найти прототип сущности с идентификатором {$id}.
cmd-removeextracomponents-success = Удалено компонентов: {$count}; обработано сущностей: {$entities},
cmd-removeextracomponents-success-with-id = Удалено компонентов: {$count}; обработано сущностей с идентификатором {$id}: {$entities}.
