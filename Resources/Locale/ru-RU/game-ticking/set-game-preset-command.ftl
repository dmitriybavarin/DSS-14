set-game-preset-command-description = Устанавливает игровой набор для указанного количества следующих раундов. Также может отображать в лобби название и описание другого набора, чтобы ввести игроков в заблуждение.
set-game-preset-command-help-text = setgamepreset <id> [количество раундов, по умолчанию 1] [набор-приманка]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [количество раундов]
set-game-preset-command-hint-3 = [набор-приманка]

set-game-preset-optional-argument-not-integer = Если указан второй аргумент, он должен быть числом.
set-game-preset-preset-error = Не удалось найти игровой набор "{$preset}"
set-game-preset-decoy-error = Если указан третий аргумент, он должен быть допустимым игровым набором. Не удалось найти игровой набор "{$preset}"

#set-game-preset-preset-set = Игровой набор установлен на "{$preset}"
set-game-preset-preset-set-finite = Игровой набор "{$preset}" установлен на следующие {$rounds} раундов.
set-game-preset-preset-set-finite-with-decoy = Игровой набор "{$preset}" установлен на следующие {$rounds} раундов. В лобби будет отображаться набор {$decoy}.
