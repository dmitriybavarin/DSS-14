
### Сообщения о взаимодействии

# Отображается, когда игрок пытается заменить лампу, но запас ламп закончился
comp-light-replacer-missing-light = В {THE($light-replacer)} не осталось ламп типа {MAKEPLURAL($light-name)}.

# Отображается, когда игрок пытается вставить перегоревшую лампу в устройство для замены ламп
comp-light-replacer-insert-broken-light = Нельзя вставлять перегоревшие лампы!

# Отображается, когда игрок пытается заменить лампу на такую же по цвету и типу, как установленная
comp-light-replacer-same-light = В этом светильнике уже установлена {INDEFINITE($light)} {$light}!

# Сообщения радиального меню
comp-light-replacer-open-empty = {CAPITALIZE(THE($light-replacer))} совершенно пуст!

# Маркировка
comp-light-replacer-label = Трубка: {$tube}
                            Лампочка: {$bulb}

