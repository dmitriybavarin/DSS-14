cmd-announce-desc = Отправляет внутриигровое объявление с заданными цветом и звуком.
cmd-announce-help = {$command} <message> [sender] [color] [sound] — отправить объявление. По умолчанию отправитель — Центральное командование, цвет — золотой, звук — announce.ogg. Цвет должен быть указан в формате #RRGGBB.

# Отправитель объявления по умолчанию
cmd-announce-sender = Центральное командование

# Подсказки для автодополнения
cmd-announce-arg-message = <message>
cmd-announce-arg-sender = [sender]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sound]
