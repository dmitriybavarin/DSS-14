
{
    "version": "2.0.0",
    "tasks": [

        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:ForceNoAlign;NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Собрать + Запустить локальный сервер (DEV)",
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--no-build",
                "--project",
                "${workspaceFolder}/Content.Server/Content.Server.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "build (C# Dev Kit)",
            "detail": "Requires the C# Dev Kit extension.",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build"
            ],
            "icon": {
                "id": "build",
                "color": "terminal.ansiBlue"
            },
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile",
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "build-yaml-linter",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Content.YAMLLinter/Content.YAMLLinter.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:ForceNoAlign;NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.Tests/Content.Tests.csproj",
                "--",
                "NUnit.ConsoleOut=0"
            ],
            "group": "test",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "integration-test",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "--no-build",
                "--configuration",
                "DebugOpt",
                "Content.IntegrationTests/Content.IntegrationTests.csproj",
                "--",
                "NUnit.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed.ConsoleOut=0",
                "NUnit.MapWarningTo=Failed"
            ],
            "group": "test",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
